{
  "name": "librecut",
  "version": "0.1.0",
  "description": "Editor de vídeo local, de código abierto, sin cuenta ni telemetría. Export hasta 1080p120 con FFmpeg nativo.",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "type": "commonjs",
  "bin": {
    "librecut": "cli/librecut.js"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "cli": "node cli/librecut.js",
    "render": "node cli/librecut.js render",
    "make": "node cli/librecut.js make"
  },
  "devDependencies": {
    "electron": "^33.2.1"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  }
}
